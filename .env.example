# Database Configuration
# Default fallback is SQLite if PostgreSQL URL is invalid/unreachable
DATABASE_URL=postgresql://postgres:1234@localhost:5432/AskDb

# Groq LLM Configuration
GROQ_API_KEY=key

# JWT Authentication Config
JWT_SECRET_KEY=change_this_to_a_secure_random_string_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ChromaDB Configuration
CHROMA_PERSIST_DIRECTORY=./chroma_data

# Demo Mode (Bypasses Groq/DB connections and serves rich mock data)
DEMO_MODE=true
